# Example Config
# NOTE: remember to restart docker compose when changing your settings!

SJS_ADMIN_EMAIL=your@email
SJS_ADMIN_PASSWORD=yourpass
SJS_ADMIN_TOKEN=secure-token
SJS_ADMIN_SECRET=some-long-random-string

# Webhook Secret for Directus Flow integration
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SJS_WEBHOOK_SECRET=your-webhook-secret-key

# JWT Secret
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SJS_JWT_SECRET=some-long-random-string

# Better Auth Configuration
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SJS_AUTH_SECRET=your-auth-secret-here

# SMTP2GO API for outbound transactional emails (password reset, etc.)
# https://app.smtp2go.com/settings/apikeys
SJS_SMTP2GO_API_KEY=api-xxxxx
SJS_EMAIL_FROM=noreply@yourdomain.com

# EmailConnect.eu — inbound verification email relay
# HMAC key from your EmailConnect.eu workflow settings
SJS_EMAILCONNECT_HMAC_KEY=your-emailconnect-hmac-key

# LLM configuration

# LLM Provider for TypeScript/SvelteKit app
# - cerebras (free tier: 1M tokens/day)
# - deepseek
# - groq
# - gemini
# - openai
# - browser_use (Browser Use Cloud)
SJS_LLM_PROVIDER=groq

# LLM Model (optional - defaults based on provider)
# Defaults:
# - cerebras: llama-3.3-70b
# - groq: meta-llama/llama-4-scout-17b-16e-instruct
# - gemini: gemini-2.0-flash-exp
# - openai: gpt-4o
# - browser_use: uses Browser Use Cloud's optimized in-house model
# SJS_LLM_MODEL=

# Browser-Use LLM Configuration (optional - defaults to main LLM settings)
# If not set, uses SJS_LLM_PROVIDER and SJS_LLM_MODEL
# Supported providers: groq, gemini, openai, deepseek, cerebras, browser_use
# Examples:
# SJS_LLM_PROVIDER_BROWSER_USE=openai
# SJS_LLM_MODEL_BROWSER_USE=gpt-4o
# Or use Browser Use Cloud (optimized in-house model, 3-5x faster):
# SJS_LLM_PROVIDER_BROWSER_USE=browser_use
# SJS_LLM_MODEL_BROWSER_USE is ignored for browser_use provider

# Scraper Timing & Rate Limiting (milliseconds)
# SJS_SCRAPER_PAGE_LOAD_TIMEOUT=3000       # Wait time after page navigation
# SJS_SCRAPER_CLICK_WAIT_TIMEOUT=1000      # Wait time after clicking elements
# SJS_SCRAPER_RATE_LIMIT_DELAY=2000        # Delay between requests to avoid rate limiting
# SJS_SCRAPER_CAPTCHA_CHECK_INTERVAL=3000  # Interval for checking CAPTCHA status
# SJS_SCRAPER_MODAL_WAIT_TIMEOUT=500       # Wait time for modal content to load

# Chrome executable path (optional - auto-detected if not set)
# SJS_CHROME_PATH=/usr/bin/google-chrome-stable

# Browser-Use Integration
# SJS_BROWSER_USE_TIMEOUT=120000
# SJS_BROWSER_USE_FALLBACK_ENABLED=true
# Browser-Use Visual Mode Configuration
# Enable visual mode (screenshots) for Browser-Use API (increases token usage, helpful for debugging)
# Default: false (disabled to reduce token costs)
# SJS_BROWSER_USE_VISION=false

# Browser-Use Service (Docker)
# SJS_BROWSER_USE_PORT=8000
SJS_BROWSER_USE_LOG_LEVEL=INFO

# Browser-Use API Key (used for both local and cloud modes)
# https://cloud.browser-use.com/settings?tab=api-keys
SJS_LLM_API_KEY_BROWSER_USE=your-api-key

# Browser-Use Cloud (alternative to local Browser-Use)
# When enabled, uses Browser-Use Cloud for login instead of local Docker service.
# Cloud handles CAPTCHA solving automatically and provides persistent browser profiles.
# SJS_BROWSER_USE_CLOUD=false                    # Set to 'true' to enable cloud mode
# SJS_BROWSER_USE_CLOUD_PROFILE_ID=               # Profile UUID from browser-use.com dashboard
# SJS_BROWSER_USE_CLOUD_TIMEOUT=60               # Session timeout in minutes (default: 60, max: 240)

# Groq API key
# https://console.groq.com/docs/quickstart
SJS_LLM_API_KEY_GROQ=your-api-key

# Cerebras API Key
# https://cloud.cerebras.ai/ (Settings -> API Keys)
# Free tier: 1M tokens/day
SJS_LLM_API_KEY_CEREBRAS=your-api-key

# Gemini API Key (Google Generative AI / Google AI Studio)
# https://aistudio.google.com/app/api-keys
SJS_LLM_API_KEY_GEMINI=your-api-key

# OpenAI API Key
# https://platform.openai.com/settings/organization/api-keys
# https://platform.openai.com/docs/api-reference/project-api-keys
SJS_LLM_API_KEY_OPENAI=your-api-key

# DeepSeek API Key
# https://platform.deepseek.com/api_keys
SJS_LLM_API_KEY_DEEPSEEK=your-api-key
