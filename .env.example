# Example Config
# NOTE: remember to restart docker compose when changing your settings!

SJS_APP_URL=http://localhost:${SJS_APP_PORT}
SJS_FROM_EMAIL=your@email
SJS_FROM_NAME=Your Name

SJS_ADMIN_SECRET=some-long-random-string
SJS_ADMIN_EMAIL=your@email
SJS_ADMIN_PASSWORD=yourpass
SJS_ADMIN_PUBLIC_URL=http://localhost:${SJS_ADMIN_PORT}
SJS_ADMIN_URL=http://admin:8085
SJS_ADMIN_TOKEN=secure-token

# LLM configuration

# LLM Provider for TypeScript/SvelteKit app
# - groq
# - gemini
# - openai
# - openrouter
# - browseruse (Browser Use Cloud)
SJS_LLM_PROVIDER=groq

# LLM Model (optional - defaults based on provider)
# Defaults:
# - groq: llama-3.3-70b-versatile
# - gemini: gemini-2.0-flash-exp
# - openai: gpt-4o
# - openrouter: anthropic/claude-3.5-sonnet
# - browseruse: uses Browser Use Cloud's optimized in-house model
# SJS_LLM_MODEL=

# Browser-Use LLM Configuration (optional - defaults to main LLM settings)
# If not set, uses SJS_LLM_PROVIDER and SJS_LLM_MODEL
# Supported providers: groq, gemini, openai, openrouter, browseruse
# Examples:
# SJS_LLM_PROVIDER_BROWSER_USE=openrouter
# SJS_LLM_MODEL_BROWSER_USE=anthropic/claude-3.5-sonnet
# Or use Browser Use Cloud (optimized in-house model, 3-5x faster):
# SJS_LLM_PROVIDER_BROWSER_USE=browseruse
# SJS_LLM_MODEL_BROWSER_USE is ignored for browseruse provider

# Scraper Method Selection
# Choose which scraping method to use:
# - browser-use: Use Browser-Use service (AI-powered, automatic pagination, faster) [DEFAULT]
# - playwright: Use Playwright with LLM extraction (more control, manual pagination, cost-effective)
SJS_SCRAPER_METHOD=browser-use

# Browser-Use Integration
# SJS_BROWSER_USE_URL=http://browser-use:8000
# SJS_BROWSER_USE_TIMEOUT=120000
# SJS_BROWSER_USE_FALLBACK_ENABLED=true

# Browser-Use Service (Docker)
# SJS_BROWSER_USE_PORT=8000
SJS_BROWSER_USE_HEADLESS=true
SJS_BROWSER_USE_LOG_LEVEL=INFO

# Browser-Use API Key
# https://cloud.browser-use.com/settings?tab=api-keys
SJS_BROWSERUSE_API_KEY=your-api-key

# Groq API key
# https://console.groq.com/docs/quickstart
SJS_GROQ_API_KEY=your-api-key

# Gemini API Key (Google Generative AI / Google AI Studio)
# https://aistudio.google.com/app/api-keys
SJS_GEMINI_API_KEY=your-api-key

# OpenAI API Key
# https://platform.openai.com/settings/organization/api-keys
# https://platform.openai.com/docs/api-reference/project-api-keys
SJS_OPENAI_API_KEY=your-api-key

# OpenRouter API Key
# https://openrouter.ai/settings/keys
SJS_OPENROUTER_API_KEY=your-api-key

# SMTP2GO API Key
SJS_SMTP2GO_API_KEY=your-api-key

# JWT Secret
SJS_JWT_SECRET=some-long-random-string

# Webhook Secret for Directus Flow integration
# Generate with: node -e console.log(require('crypto').randomBytes(32).toString('hex'))
SJS_WEBHOOK_SECRET=your-webhook-secret-key

# LLM cache TTL in milliseconds (1 hour default)
SJS_LLM_CACHE_TTL=3600000

# Retry configuration
SJS_RETRY_MAX_ATTEMPTS=3
SJS_RETRY_INITIAL_DELAY=1000
SJS_RETRY_MAX_DELAY=10000

# Scraper wait configuration (optional - sensible defaults provided)
# Default timeout for page loads in milliseconds
# SJS_SCRAPER_DEFAULT_TIMEOUT=30000
# Timeout for networkidle2 waits (for slow SPAs like LinkedIn)
# SJS_SCRAPER_NETWORK_IDLE_TIMEOUT=45000
# Max retry attempts for failed scrapes
# SJS_SCRAPER_MAX_RETRIES=2
# Enable debug mode with detailed logging
# SJS_SCRAPER_DEBUG_MODE=false
# Max iterations for infinite scroll detection
# SJS_SCRAPER_SCROLL_MAX_ITERATIONS=3
# Save screenshots on failures for debugging
# SJS_SCRAPER_SAVE_DEBUG_SCREENSHOTS=false

# Database settings
SJS_DATABASE_URL=prisma+postgres://localhost:51213/?api_key=your-prisma-api-key

# Directus docker settings:
SJS_DB_CLIENT=pg
SJS_DB_HOST=database
SJS_DB_PORT=5432
SJS_DB_DATABASE=smartjobseeker
SJS_DB_USER=postgres
SJS_DB_PASSWORD=postgres
SJS_DB_SSL=false

# Direct PostgreSQL connection URLs:
# When running inside Docker containers, use 'database' as hostname
SJS_POSTGRES_URL_DOCKER=postgres://postgres:postgres@database:5432/smartjobseeker

# When running on host (e.g., scripts), use 'localhost' to connect to exposed port
SJS_POSTGRES_URL_HOST=postgres://postgres:postgres@localhost:${SJS_DB_PORT}/smartjobseeker
