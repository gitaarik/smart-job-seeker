# Production build: bakes source code and build output into the image.
# Code changes produce a new image hash, so docker compose recreates the container.
#
# Development uses bind-mounts + vite dev (see Dockerfile for dev image).

FROM node:22-slim AS build

RUN apt-get update && apt-get install -y --no-install-recommends \
    openssl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install dependencies (cached unless package files change)
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts --include=dev --legacy-peer-deps

# Copy source and build
COPY . .
RUN npx svelte-kit sync

# SvelteKit's postbuild analysis imports all server modules, triggering
# getEnv() calls. SJS_BUILDING makes getEnv() return placeholders instead
# of throwing.
ENV SJS_BUILDING="true"
RUN npx vite build

# ---

FROM node:22-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    openssl \
    ca-certificates \
    curl \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy built app and dependencies from build stage
COPY --from=build /app/build ./build
COPY --from=build /app/node_modules ./node_modules

# Install Patchright Chromium + system dependencies for PDF generation.
# Must run AFTER copying node_modules so the browser revision matches the
# patchright version the app was built with.
RUN npx patchright install --with-deps chromium
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/scripts ./scripts
COPY --from=build /app/drizzle.config.ts ./drizzle.config.ts
COPY --from=build /app/drizzle ./drizzle

# .env files are mounted at runtime via docker-compose volumes

EXPOSE 5173

CMD ["/app/scripts/start-app-production.sh"]
