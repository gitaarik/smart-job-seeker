{
	// Type-check the CLI scripts.
	//
	// The main tsconfig cannot do this without type-checking scripts/ as part
	// of the app, which reports the app's own backlog twice.
	//
	// Nothing had ever type-checked scripts/, and it showed: the Prisma → Drizzle
	// migration passed 11 of them by entirely, and generate-profile-slugs.ts
	// imported $lib/server/slug-generator — a path that has never existed — for
	// however long, with no error anywhere.
	//
	// Extending SvelteKit's generated base config (node_modules/$app/tsconfig.json)
	// keeps the same resolution as the app: #lib is a package.json subpath
	// import, and `$app/types` declares the `$app/*` modules that src/ imports.
	// Only `include` and the script-specific options differ.
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"checkJs": false,
		"strict": true,
		"types": ["node", "$app/types"]
	},
	// scripts/ only. Whatever they import from #lib is pulled in transitively;
	// listing src/ as roots as well just re-reports the app's own backlog here.
	//
	// app.d.ts is the exception, because nothing imports it: it is an ambient
	// declaration, and the one it makes is `App.Locals`. Without it the program
	// falls back on SvelteKit's empty default, so every transitively-reached
	// `locals.user` reads as a property that does not exist — thirteen errors
	// about the app being wrong when the config was.
	"include": ["scripts/**/*.ts", "src/app.d.ts"],
	"exclude": ["node_modules/**"]
}
