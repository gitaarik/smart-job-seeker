  platform_profiles      platform_profiles?       @relation(fields: [platform_profile_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  profiles               profiles                 @relation(fields: [profile], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "search_tasks_profile_foreign")
  search_tasks_job_sites search_tasks_job_sites[]

