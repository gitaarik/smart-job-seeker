}

model search_tasks {
  id                     Int                      @id @default(autoincrement())
  status                 String?                  @default("idle") @db.VarChar(50)
  date_created           DateTime?                @db.Timestamptz(6)
  date_updated           DateTime?                @db.Timestamptz(6)
  note                   String?                  @db.VarChar(500)
  profile                Int
  last_run               DateTime?                @db.Timestamptz(6)
  search_url             String?
  platform               Int?
  navigation_type        String?                  @db.VarChar(255)
  stripped_html          String?
  last_run_jobs_found    Int?
  live_url               String?                  @db.VarChar(500)
  is_active              Boolean                  @default(true)
  status_message         String?                  @db.VarChar(255)
  platform_profile_id    Int?
  max_jobs               Int?
  browser_provider       String?                  @db.VarChar(20)
  search_term            String?                  @db.VarChar(500)
  skip_existing          Boolean                  @default(false)
  skip_first             Int?
  stop_after_duplicates  Int?
  keep_minimized         Boolean?                 @default(true)
  ui_preferences         Json?                    @default("{}")
  extracted_jobs_json    String?
