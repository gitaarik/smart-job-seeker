}

model search_tasks_job_sites {
  id              Int           @id @default(autoincrement())
  search_tasks_id Int?
  search_tasks    search_tasks? @relation(fields: [search_tasks_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "search_tasks_job_sites_search_tasks_id_foreign")
}

model scraper_agent_sessions {
  id                 Int                        @id @default(autoincrement())
  search_task_id     Int
  status             String                     @default("active") @db.VarChar(20)
  max_iterations     Int                        @default(10)
  current_iteration  Int                        @default(0)
  run_first          Boolean                    @default(false)
  goal               String
  claude_session_id  String?                    @db.VarChar(255)
  system_prompt      String?
  pending_hint       String?
  needs_input        String?
  error_message      String?
  created_at         DateTime                   @default(now()) @db.Timestamptz(6)
  updated_at         DateTime                   @default(now()) @db.Timestamptz(6)
  finished_at        DateTime?                  @db.Timestamptz(6)
  iterations         scraper_agent_iterations[]
  search_tasks       search_tasks               @relation(fields: [search_task_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([status])
  @@index([search_task_id])
}

model scraper_agent_iterations {
  id               Int                      @id @default(autoincrement())
  session_id       Int
  iteration        Int
  stage            String?                  @db.VarChar(30)
  run_id           Int?
  run_status       String?                  @db.VarChar(50)
  items_total      Int?
  items_completed  Int?
  items_error      Int?
  success_pct      Float?
  goal_met         Boolean?
  goal_evaluation  String?
  prompt           String?
  claude_analysis  String?
  claude_changes   String?
  started_at       DateTime                 @default(now()) @db.Timestamptz(6)
  finished_at      DateTime?                @db.Timestamptz(6)
  session          scraper_agent_sessions   @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  search_task_runs search_task_runs?        @relation(fields: [run_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([session_id, iteration])
}

model import_logs {
  id           Int       @id @default(autoincrement())
  date_created DateTime  @default(now()) @db.Timestamptz(6)
  user_id      String    @db.VarChar(255)
  user_email   String?   @db.VarChar(255)
  profile_id   Int?
  event        String    @db.VarChar(50) // "parse", "apply", "parse_error", "apply_error"
  file_name    String?   @db.VarChar(255)
  file_format  String?   @db.VarChar(50)
  doc_type     String?   @db.VarChar(20) // "partial" or "full"
  sections     Json?     @db.Json // { work: 3, education: 2, ... }
  changes      Json?     @db.Json // { work: { added: 1, modified: 2 }, ... }
  parsed_data  Json?     @db.Json // full parsed ResumeData for parse events
  file_id      String?   @db.VarChar(255) // Directus file ID of the uploaded document
  error        String?

  @@index([user_id])
  @@index([date_created])
}

