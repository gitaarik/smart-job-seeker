{
  "name": "smart-job-seeker",
  "private": true,
  "version": "0.6.1",
  "type": "module",
  "scripts": {
    "dev": "docker compose up",
    "dev:reset": "DB_RESET=true docker compose up",
    "init": "npm i",
    "build": "npm i && dotenvx run -- vite build",
    "start": "dotenvx run -- node build",
    "reinstall": "npm ci",
    "docker:build": "docker compose exec app npm run host:build -- --host",
    "docker:cli": "docker compose exec -it app /bin/bash",
    "docker:env-run": "docker compose exec -it app dotenvx run --",
    "docker:update-schema": "docker compose exec app npx drizzle-kit introspect",
    "docker:export-profiles-pdf": "docker compose exec app npm run host:export-profiles-pdf --",
    "docker:export-profile-json": "docker compose exec app npm run host:export-profile-json",
    "docker:export-collected-data": "docker compose exec app npm run host:export-collected-data",
    "docker:import-profile-json": "docker compose exec app npm run host:import-profile-json",
    "docker:import-json-resume": "docker compose exec app npm run host:import-json-resume",
    "docker:import-pdf-resume": "docker compose exec app npm run host:import-pdf-resume",
    "docker:export-to-json-resume": "docker compose exec app npm run host:export-to-json-resume --",
    "docker:migrate-location-to-json": "docker compose exec app npm run host:migrate-location-to-json",
    "docker:generate-profile-slugs": "docker compose exec app npm run host:generate-profile-slugs",
    "docker:match:jobs": "echo 'Moved to cloud — use npm run match:jobs from the cloud directory'",
    "docker:db:cli": "dotenvx run -- sh -c 'docker compose exec database psql -U ${SJS_DB_USER:-postgres} -d ${SJS_DB_DATABASE:-smartjobseeker}'",
    "docker:db:backup": "docker compose exec database ./scripts/dump-db.sh",
    "docker:db:restore": "docker compose exec database ./scripts/restore-last-db-dump.sh",
    "docker:db:create-dev-seed": "docker compose exec app npx vite-node scripts/create-dev-seed.ts",
    "docker:db:migrate:new": "docker compose exec app npx drizzle-kit generate",
    "docker:db:migrate:deploy": "docker compose exec app npx drizzle-kit migrate",
    "docker:db:push:production": "npx tsx scripts/db-push-production.ts",
    "docker:seed:test-user": "docker compose exec app npm run host:seed:test-user",
    "docker:demo:seed-template": "docker compose exec app npm run host:demo:seed-template",
    "host:dev": "dotenvx run -- vite dev",
    "host:build": "dotenvx run -- vite build",
    "host:preview": "dotenvx run -- vite preview",
    "host:export-profiles-pdf": "npx vite-node scripts/export-profiles-pdf.ts",
    "host:export-profile-json": "npx vite-node scripts/export-profile-json.ts",
    "host:export-collected-data": "npx vite-node scripts/export-collected-data.ts",
    "host:import-profile-json": "npx vite-node scripts/import-profile.ts",
    "host:import-json-resume": "npx vite-node scripts/import-from-json-resume.ts",
    "host:import-pdf-resume": "npx vite-node scripts/import-from-pdf-resume.ts",
    "host:export-to-json-resume": "npx tsx scripts/export-to-json-resume.ts",
    "host:migrate-location-to-json": "npx tsx scripts/migrate-location-to-json.ts",
    "host:generate-profile-slugs": "npx tsx scripts/generate-profile-slugs.ts",
    "host:build-json-resume": "npx vite-node scripts/build-json-resume.ts",
    "host:seed:test-user": "npx vite-node scripts/seed-test-user.ts",
    "host:demo:export-template": "npx vite-node scripts/demo-export-template.ts --",
    "host:demo:seed-template": "npx vite-node scripts/demo-seed-template.ts",
    "host:set-user-password": "npx vite-node scripts/set-user-password.ts --",
    "host:trigger-run": "npx vite-node scripts/trigger-run.ts --",
    "host:suggest-task": "npx vite-node scripts/suggest-task.ts --",
    "host:trigger-search-form-probe": "npx vite-node scripts/trigger-search-form-probe.ts --",
    "host:migrate-search-terms": "npx vite-node scripts/migrate-search-terms.ts",
    "host:match:jobs": "echo 'Moved to cloud — use npm run match:jobs from the cloud directory'",
    "container:match:jobs": "echo 'Moved to cloud — use npm run match:jobs from the cloud directory'",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:e2e": "vitest run --config e2e/vitest.config.ts"
  },
  "devDependencies": {
    "@eslint/compat": "^1.2.5",
    "@eslint/js": "^9.18.0",
    "@sveltejs/adapter-node": "^5.5.4",
    "@sveltejs/enhanced-img": "^0.10.4",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/cheerio": "^0.22.35",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pdf-parse": "^1.1.5",
    "@types/uuid": "^10.0.0",
    "@vitest/ui": "^4.1.8",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-svelte": "^3.19.0",
    "globals": "^16.0.0",
    "jsdom": "^25.0.1",
    "jsonresume-theme-even": "^0.26.1",
    "prettier": "^3.8.4",
    "prettier-plugin-svelte": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "resumed": "^6.0.0",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.0.16",
    "vite-node": "^5.2.0",
    "vitest": "^4.0.8",
    "wait-on": "^9.0.10"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^1.71.2",
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-brands-svg-icons": "^7.2.0",
    "@fortawesome/free-regular-svg-icons": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/svelte-fontawesome": "^0.2.3",
    "@hono/zod-openapi": "^1.4.0",
    "@langchain/cerebras": "^1.0.4",
    "@langchain/community": "^1.1.29",
    "@langchain/core": "^1.1.48",
    "@langchain/google-genai": "^2.1.31",
    "@langchain/groq": "^1.2.1",
    "@langchain/openai": "^1.4.7",
    "@noble/ciphers": "^2.2.0",
    "@sentry/sveltekit": "^10.57.0",
    "@smithy/eventstream-codec": "^2.2.0",
    "@smithy/protocol-http": "^3.3.0",
    "@smithy/signature-v4": "^2.3.0",
    "@smithy/util-utf8": "^2.0.0",
    "@tiptap/core": "^3.26.0",
    "@tiptap/extension-bubble-menu": "^3.26.0",
    "@tiptap/extension-link": "^3.22.4",
    "@tiptap/extension-placeholder": "^3.26.0",
    "@tiptap/markdown": "^3.26.0",
    "@tiptap/pm": "^3.22.4",
    "@tiptap/starter-kit": "^3.26.0",
    "@types/pg": "^8.20.0",
    "aos": "^2.3.4",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.6.16",
    "bullmq": "^5.78.0",
    "cheerio": "^1.1.2",
    "chrono-node": "^2.9.1",
    "commander": "^14.0.2",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.25",
    "i18n-iso-countries": "^7.14.0",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.1",
    "langchain": "^1.4.4",
    "mammoth": "^1.12.0",
    "marked": "^18.0.5",
    "patchright": "^1.60.2",
    "pdf-parse": "^2.4.5",
    "pg": "^8.21.0",
    "remove-markdown": "^0.6.4",
    "sharp": "^0.34.5",
    "stripe": "^22.2.0",
    "svelte-dnd-action": "^0.9.69",
    "tsx": "^4.22.4",
    "uuid": "^11.1.0",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.25.2",
    "kysely": "0.29.2"
  },
  "volta": {
    "node": "22.14.0"
  },
  "overrides": {
    "kysely": "0.29.2",
    "@xmldom/xmldom": "^0.8.13",
    "underscore": "^1.13.8",
    "defu": "^6.1.5",
    "cookie": "^0.7.0"
  }
}
