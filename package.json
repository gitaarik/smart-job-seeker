{
	"name": "smart-job-seeker",
	"private": true,
	"version": "0.26.1",
	"type": "module",
	"scripts": {
		"dev": "docker compose up",
		"dev:reset": "DB_RESET=true docker compose up",
		"init": "npm i",
		"build": "npm i && dotenvx run -- vite build",
		"start": "dotenvx run -- node build",
		"reinstall": "npm ci",
		"docker:build": "docker compose exec app npm run host:build -- --host",
		"docker:cli": "docker compose exec -it app /bin/bash",
		"docker:env-run": "docker compose exec -it app dotenvx run --",
		"docker:update-schema": "docker compose exec app npx drizzle-kit introspect",
		"docker:export-profile-json": "docker compose exec app npm run host:export-profile-json",
		"docker:migrate-location-to-json": "docker compose exec app npm run host:migrate-location-to-json",
		"docker:match:jobs": "echo 'Moved to cloud — use npm run match:jobs from the cloud directory'",
		"docker:db:cli": "dotenvx run -- sh -c 'docker compose exec database psql -U ${SJS_DB_USER:-postgres} -d ${SJS_DB_DATABASE:-smartjobseeker}'",
		"docker:db:backup": "docker compose exec database ./scripts/dump-db.sh",
		"docker:db:restore": "docker compose exec database ./scripts/restore-last-db-dump.sh",
		"docker:db:create-dev-seed": "docker compose exec app npx vite-node scripts/create-dev-seed.ts",
		"docker:db:migrate:new": "docker compose exec app npx drizzle-kit generate",
		"docker:db:migrate:deploy": "docker compose exec app npx drizzle-kit migrate",
		"docker:db:push:production": "npx tsx scripts/db-push-production.ts",
		"docker:seed:test-user": "docker compose exec app npm run host:seed:test-user",
		"docker:demo:seed-template": "docker compose exec app npm run host:demo:seed-template",
		"host:dev": "dotenvx run -- vite dev",
		"host:build": "dotenvx run -- vite build",
		"host:preview": "dotenvx run -- vite preview",
		"host:export-profile-json": "npx vite-node scripts/export-profile-json.ts",
		"host:migrate-location-to-json": "npx tsx scripts/migrate-location-to-json.ts",
		"host:seed:test-user": "dotenvx run --quiet -f .env -- npx vite-node scripts/seed-test-user.ts",
		"host:demo:export-template": "npx vite-node scripts/demo-export-template.ts --",
		"host:demo:seed-template": "npx vite-node scripts/demo-seed-template.ts",
		"host:trigger-run": "npx vite-node scripts/trigger-run.ts --",
		"host:suggest-task": "npx vite-node scripts/suggest-task.ts --",
		"host:trigger-search-form-probe": "npx vite-node scripts/trigger-search-form-probe.ts --",
		"host:migrate-search-terms": "npx vite-node scripts/migrate-search-terms.ts",
		"host:match:jobs": "echo 'Moved to cloud — use npm run match:jobs from the cloud directory'",
		"container:match:jobs": "echo 'Moved to cloud — use npm run match:jobs from the cloud directory'",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:scripts": "svelte-kit sync && tsc -p tsconfig.scripts.json --noEmit",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test": "vitest run",
		"test:watch": "vitest --watch",
		"test:ui": "vitest --ui",
		"test:coverage": "vitest --coverage",
		"test:e2e": "vitest run --config e2e/vitest.config.ts",
		"host:seed:dev-users": "dotenvx run --quiet -f .env -- npx vite-node scripts/seed-dev-users.ts",
		"docker:seed:dev-users": "docker compose exec app npm run host:seed:dev-users"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/svelte": "^5.4.2",
		"@types/bcryptjs": "^3.0.0",
		"@types/cheerio": "^1.0.0",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/pdf-parse": "^1.1.5",
		"@types/uuid": "^11.0.0",
		"@vitest/ui": "^4.1.10",
		"drizzle-kit": "^0.31.10",
		"esbuild": "^0.28.2",
		"eslint": "^10.8.1",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.11.0",
		"jsdom": "^30.0.1",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.56.9",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.0.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.67.0",
		"vite": "^8.2.1",
		"vite-node": "^6.0.0",
		"vitest": "^4.0.8",
		"wait-on": "^9.1.0"
	},
	"dependencies": {
		"@dotenvx/dotenvx": "^2.21.0",
		"@fortawesome/fontawesome-svg-core": "^7.3.1",
		"@fortawesome/free-brands-svg-icons": "^7.3.1",
		"@fortawesome/free-regular-svg-icons": "^7.3.1",
		"@fortawesome/free-solid-svg-icons": "^7.3.1",
		"@fortawesome/svelte-fontawesome": "^0.2.3",
		"@hono/zod-openapi": "^1.5.3",
		"@langchain/cerebras": "^1.0.4",
		"@langchain/core": "^1.2.6",
		"@langchain/google-genai": "^2.2.0",
		"@langchain/groq": "^1.3.1",
		"@langchain/openai": "^1.5.7",
		"@noble/ciphers": "^2.3.0",
		"@sentry/sveltekit": "^10.70.0",
		"@tiptap/core": "^3.30.1",
		"@tiptap/extension-bubble-menu": "^3.30.1",
		"@tiptap/extension-link": "^3.22.4",
		"@tiptap/extension-placeholder": "^3.30.1",
		"@tiptap/markdown": "^3.30.1",
		"@tiptap/pm": "^3.22.4",
		"@tiptap/starter-kit": "^3.30.1",
		"@types/pg": "^8.21.0",
		"@xyflow/svelte": "^1.6.5",
		"aos": "^2.3.4",
		"bcryptjs": "^3.0.3",
		"better-auth": "^1.6.27",
		"bullmq": "^6.1.0",
		"cheerio": "^1.1.2",
		"chrono-node": "^2.10.1",
		"date-fns": "^4.4.0",
		"drizzle-orm": "^0.45.2",
		"hono": "^4.13.2",
		"i18n-iso-countries": "^7.14.0",
		"ioredis": "^6.0.0",
		"jsonwebtoken": "^9.0.2",
		"jszip": "^3.10.1",
		"kysely": "0.29.5",
		"langchain": "^1.5.7",
		"mammoth": "^1.12.1",
		"marked": "^18.0.9",
		"patchright": "^1.61.1",
		"pdf-parse": "^2.4.5",
		"pg": "^8.23.0",
		"postal-mime": "^3.0.0",
		"remove-markdown": "^0.6.4",
		"sharp": "^0.35.3",
		"stripe": "^22.5.0",
		"svelte-dnd-action": "^0.9.78",
		"tsx": "^4.23.12",
		"uuid": "^14.0.1",
		"zod": "^4.4.3",
		"zod-to-json-schema": "^3.25.2"
	},
	"volta": {
		"node": "22.14.0"
	},
	"overrides": {
		"@fortawesome/fontawesome-common-types": "^7.3.1",
		"kysely": "0.29.5",
		"@langchain/cerebras": {
			"uuid": "^11.1.1"
		},
		"@esbuild-kit/core-utils": {
			"esbuild": "^0.25.0"
		},
		"brace-expansion@1": "^1.1.17",
		"@xmldom/xmldom": "^0.8.13",
		"underscore": "^1.13.8",
		"defu": "^6.1.5",
		"cookie": "^0.7.0"
	}
}
