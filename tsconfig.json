{
	// SvelteKit 3 writes its base config to node_modules/$app/tsconfig.json
	// (allowJs, checkJs, bundler resolution, allowImportingTsExtensions, the
	// generated route types). Unlike Kit 2's .svelte-kit/tsconfig.json it sets
	// no `include`, so the list below is ours to keep.
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"sourceMap": true,
		"strict": true
	},
	"include": ["src", "vite.config.ts", "drizzle.config.ts"]
}
